# Local port. On Railway/Render/Fly leave this unset; they provide PORT.
WORKER_PORT=4000
# Same value as WORKER_SECRET on the site.
WORKER_SECRET=
# Public address of the site. The worker only prints PDFs from this origin.
APP_URL=http://localhost:3000
# Scans that may run at the same time.
MAX_CONCURRENT_SCANS=2
# Development and tests only: allow scanning localhost.
ALLOW_PRIVATE_TARGETS=
# The testing agent. Without a key the worker runs axe-core only.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
AGENT_MODEL=
# Optional. The page sites see in the scanner's user agent; defaults to APP_URL/bot.
BOT_INFO_URL=
