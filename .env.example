# Copy to .env.local for development. Never commit real values.
# `npm run setup` creates .env.local with working local defaults.

# ── App ───────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash.
APP_URL=http://localhost:3000
# Long random string. Signs sign-in cookies and email links.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Email addresses allowed to open /admin (comma separated).
ADMIN_EMAILS=
# Where alerts about failed scans and new monitoring requests go.
OWNER_EMAIL=
# Public contact address (scanner opt-out, legal pages).
CONTACT_EMAIL=
# Your business postal address. Shown in offer emails (anti-spam law).
COMPANY_ADDRESS=

# ── Database (Supabase Postgres in production) ────────────────────────
# Supabase: Project Settings → Database → Connection string → Transaction
# pooler (port 6543). Locally, `npm run db:start` serves this address.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/legible

# ── Scan worker (worker/ folder, deployed to Railway/Render/Fly) ──────
WORKER_URL=http://localhost:4000
# Shared secret between the site and the worker. Same value on both.
WORKER_SECRET=

# ── Testing agent spending ────────────────────────────────────────────
# The same Anthropic API key the worker uses. Paste it yourself; never commit it.
ANTHROPIC_API_KEY=
# Prices in US dollars per million tokens, from the Anthropic pricing page
# for the model the worker uses (AGENT_MODEL). Without both, the agent is off.
AGENT_PRICE_INPUT_PER_MTOK=
AGENT_PRICE_OUTPUT_PER_MTOK=
# Free scans stop using the agent once today's spend (UTC) reaches this.
AGENT_DAILY_CAP_USD=10

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price of one full report in cents (9900 = $99).
REPORT_PRICE_CENTS=9900

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Legible <reports@example.com>"
EMAIL_REPLY_TO=

# ── Scheduled jobs (Vercel Cron sends this as a Bearer token) ─────────
CRON_SECRET=

# ── Development only. Leave unset in production. ──────────────────────
# Lets you test the full purchase flow without Stripe keys.
ALLOW_FAKE_PAYMENTS=
# Lets the scanner reach localhost. Used by the automated tests only.
ALLOW_PRIVATE_TARGETS=
